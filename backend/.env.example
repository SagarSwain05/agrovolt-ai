# ── Copy to backend/.env and fill in. Never commit .env. ───────────────────
PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/agrovolt-ai
# MONGO_DB_NAME=agrovolt_localtest      # optional: override database name
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:3000

# AI — Gemini key pool (comma-separated). Without keys Sahayak uses the rule engine.
GEMINI_API_KEYS=
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash

# Vision (Scan Hub)
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_API_URL=https://serverless.roboflow.com

# Data sources
AGMARKNET_API_KEY=            # data.gov.in
OPENWEATHER_API_KEY=          # optional, place names
WEATHER_PROXY_URL=https://agrovolt-ai.vercel.app/api/om   # relay when Open-Meteo throttles
WEATHER_PROXY_KEY=            # must match the Vercel env var of the same name

# Email (Brevo) — verification codes, password reset, alert emails
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=AgroVolt AI
EMAIL_DRY_RUN=true            # dev: log emails instead of sending

# Web push (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional integrations
# BHASHINI_USER_ID=  BHASHINI_API_KEY=            # Govt. Bhashini TTS (Odia/Hindi)
# TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  TWILIO_SMS_FROM=  TWILIO_WHATSAPP_FROM=
# WHATSAPP_TOKEN=  WHATSAPP_PHONE_ID=  WHATSAPP_TEMPLATE=
# MQTT_URL=  MQTT_USERNAME=  MQTT_PASSWORD=     # external broker bridge (built-in /mqtt broker is always on)
# MQTT_BROKER=off                               # disable the built-in broker
# GRID_EF_KG_PER_KWH=0.82  GRID_EF_SOURCE=...   # MRV baseline override
# DISABLE_SCHEDULER=true                         # dev: no background jobs
# DEMO_PASSWORD=Demo@2026                        # scripts/seedDemo.js
